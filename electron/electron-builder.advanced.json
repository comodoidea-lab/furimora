{
  "appId": "com.comodoidea.furimora.advanced",
  "productName": "ZaikoBang Advanced",
  "directories": {
    "output": "dist/advanced",
    "buildResources": "build"
  },
  "files": [
    "main.mjs",
    "control.mjs",
    "consent.mjs",
    "advanced-state.mjs",
    "ops/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.business",
    "icon": "build/icon.icns",
    "target": [
      {
        "target": "dir",
        "arch": [
          "arm64"
        ]
      }
    ],
    "identity": null,
    "extraResources": [
      {
        "from": "build/mac-icon/Assets.car",
        "to": "Assets.car"
      }
    ],
    "extendInfo": {
      "CFBundleIconName": "AppIcon"
    }
  }
}
